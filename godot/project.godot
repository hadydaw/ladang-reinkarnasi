; Ladang Reinkarnasi - proyek Godot (Tahap C: prototipe native)
config_version=5

[application]
config/name="Ladang Reinkarnasi"
config/description="Game farming isekai, versi Godot native"
run/main_scene="res://scenes/Kebun.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
